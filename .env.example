# Copy to .env.local and fill in. On Vercel/Netlify add the same names as environment variables.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY
VITE_TMDB_API_KEY=YOUR_TMDB_V3_API_KEY
# Optional: without it the "What should we watch?" helper uses a built-in filter instead of Gemini
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Optional: country for "where to watch" (2-letter code, default IN)
VITE_WATCH_REGION=IN
